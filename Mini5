		self.Theme.BackGroundTran = 0
	end
end

-- Сдвиг позиции при смене AnchorPoint (чтобы окно визуально не прыгало)
local function reanchor(gui, newAnchor)
	local delta = newAnchor - gui.AnchorPoint
	gui.AnchorPoint = newAnchor
	gui.Position = gui.Position + ud2(0, delta.X * gui.AbsoluteSize.X, 0, delta.Y * gui.AbsoluteSize.Y)
end

function Library:Minimaze()
