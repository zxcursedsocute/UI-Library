function Library:SelectTab(tab, button)
	for _, t in ipairs(self.mainTabs) do
		if t.Container then t.Container.Visible = false end
		if t.Button then self:Tween(t.Button, {BackgroundTransparency = 1}, 0.2) end
		if t.Frame then
			self:Tween(t.Frame, {BackgroundTransparency = 1, Size = ud2(0, 2, 0, 0)}, 0.2)
		end
	end

	if not tab.IsLoaded then
		for _, renderElement in ipairs(tab.RenderQueue) do
			renderElement()
		end
		tab.IsLoaded = true
	end

	if tab.Container then tab.Container.Visible = true end

	if button then
		self:Tween(button, {BackgroundTransparency = self.Theme.TabTransparancy}, 0.2)
		self:Tween(tab.Frame, {BackgroundTransparency = 0, Size = ud2(0, 2, 0, 23)}, 0.2)
	end

	self.CurrentTab = tab
	self.TextLabel_5.Text = tab.Name
end

local TweenCache = {}
local ActiveTweens = setmetatable({}, {__mode = "k"})

function Library:Tween(instance, properties, duration)
	duration = duration or 0.3

	local info = TweenCache[duration]
	if not info then
		info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenCache[duration] = info
	end

	local objectTweens = ActiveTweens[instance]
	if not objectTweens then
		objectTweens = {}
		ActiveTweens[instance] = objectTweens
	end

	for property in pairs(properties) do
		local oldTween = objectTweens[property]
		if oldTween then
			oldTween:Cancel()
		end
	end

	local tween = TweenService:Create(instance, info, properties)

	for property in pairs(properties) do
		objectTweens[property] = tween
	end

	tween.Completed:Once(function()
		for property in pairs(properties) do
			if objectTweens[property] == tween then
				objectTweens[property] = nil
			end
		end

		if next(objectTweens) == nil then
			ActiveTweens[instance] = nil
		end
	end)

	tween:Play()
	return tween
end

