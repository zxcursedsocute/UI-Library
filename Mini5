	-- ==================== AddToggle ====================
	function tab:AddToggle(config)
		local toggleController = {
			Value = config.Default or false,
			Elem = nil,
			UpdateVisuals = function() end,

			SetState = function(ctrl, state)
				if state == ctrl.Value then return end
				ctrl.Value = state
				if config.Callback then
					task.spawn(config.Callback, state)
				end
				ctrl:UpdateVisuals(state, false)
			end,

			GetState = function(ctrl)
				return ctrl.Value
			end,

			Toggle = function(ctrl)
				ctrl:SetState(not ctrl.Value)
			end
		}

		self.AllElements.Toggles[config.Name] = toggleController

		local renderFunc = function()
			local Toggle = self:CreateRow("TextButton", config.Name, config.Description or "", 15)

			local sliderbutton = create("Frame", {
				BackgroundColor3 = self.Theme.ToggleButton,
				BackgroundTransparency = self.Theme.ToggleTran,
				BorderSizePixel = 0, Position = ud2(0.8, 0, 0.206, 0),
				Size = ud2(0, 54, 0, 25), Parent = Toggle
			})
			corner(ud(0, 12), sliderbutton)

			local Frame = create("Frame", {
				BorderSizePixel = 0, Position = ud2(0, 3, 0.12, 0),
				Size = ud2(0, 19, 0, 19), Parent = sliderbutton
			})
			corner(ud(0, 35), Frame)
			self:AddThemeObject(Frame, "BackgroundColor3", "Togglebtn")

			toggleController.Elem = Toggle

			toggleController.UpdateVisuals = function(ctrl, state, instant)
				local currentTheme = Library.Theme or self.Theme
				local targetPos = state and ud2(0, 32, 0.12, 0) or ud2(0, 3, 0.12, 0)
				local targetColor = state and currentTheme.TogleActivColor or currentTheme.ToggleButton
				local targetTran = state and 0 or currentTheme.ToggleTran

				if instant then
					Frame.Position = targetPos
					sliderbutton.BackgroundColor3, sliderbutton.BackgroundTransparency = targetColor, targetTran
				else
					Library:Tween(Frame, {Position = targetPos}, 0.2)
					Library:Tween(sliderbutton, {BackgroundColor3 = targetColor, BackgroundTransparency = targetTran}, 0.2)
				end
			end

			local clickConnection = Toggle.MouseButton1Click:Connect(function()
				toggleController:Toggle()
			end)
			table.insert(tab.Connections, clickConnection)

			toggleController:UpdateVisuals(toggleController.Value, true)
		end

		return register(tab, toggleController, renderFunc)
	end

	-- ==================== AddKeybind ====================
	function tab:AddKeybind(config)
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			return nil
		end

		local currentKey = (typeof(config.Default) == "EnumItem") and config.Default or nil
		local keybindName = config.Name or "Keybind"
		local desc = config.Description or ""

		local keybindObj = {
			Name = keybindName,
			Elem = nil,
			Callback = config.Callback,
			GetState = function()
				return currentKey
			end
		}

		function keybindObj:SetKey(newKey)
			currentKey = newKey
			if self._bindButton then
				self._bindButton.Text = (typeof(newKey) == "EnumItem" and newKey.Name) or "None"
			end
		end

		if self.AllElements and self.AllElements.Keybinds then
			self.AllElements.Keybinds[keybindName] = keybindObj
		end

		if not self.AllElements.GlobalKeybindConnection then
			self.AllElements.GlobalKeybindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if gameProcessed then return end

				if input.UserInputType == enum.UserInputType.Keyboard then
					for _, kbObj in pairs(self.AllElements.Keybinds) do
						local key = kbObj:GetState()
						if key and input.KeyCode == key and kbObj.Callback then
							task.spawn(kbObj.Callback)
						end
					end
				end
			end)
		end

		local renderFunc = function()
			local container = self:CreateRow("Frame", keybindName, desc)

			local bindButton = create("TextButton", {
				Position = ud2(0.672, 0, 0.221, 0), Size = ud2(0, 100, 0, 25),
				Font = FONT, TextSize = 14, Parent = container
			})
			self:themeObj(bindButton, {
				BackgroundColor3 = "BackGroundElemCol",
				BackgroundTransparency = "BackGroundButtonTran",
				TextColor3 = "TabTextColor"
			})
			corner(ud(0, 5), bindButton)

			keybindObj.Elem = container
			keybindObj._bindButton = bindButton

			bindButton.Text = (typeof(currentKey) == "EnumItem" and currentKey.Name) or "None"

			local BlacklistedKeys = {
				[enum.KeyCode.Unknown] = true, [enum.KeyCode.W] = true,
				[enum.KeyCode.A] = true, [enum.KeyCode.S] = true,
				[enum.KeyCode.D] = true, [enum.KeyCode.Escape] = true,
				[enum.KeyCode.Space] = true, [enum.KeyCode.Backspace] = true
			}

			local selectConnection
			selectConnection = bindButton.MouseButton1Click:Connect(function()
				bindButton.Text = "..."
				local connection

				connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
					task.wait()
					if gameProcessed and input.UserInputType == enum.UserInputType.Keyboard then return end

					if input.UserInputType == enum.UserInputType.Keyboard then
						if not BlacklistedKeys[input.KeyCode] then
							keybindObj:SetKey(input.KeyCode)
						else
							keybindObj:SetKey(nil)
						end
						connection:Disconnect()
					elseif input.UserInputType == enum.UserInputType.MouseButton1 or input.UserInputType == enum.UserInputType.MouseButton2 then
						keybindObj:SetKey(nil)
						connection:Disconnect()
					end
				end)
			end)
			table.insert(tab.Connections, selectConnection)
		end

		return register(tab, keybindObj, renderFunc)
	end

