					tabRef:AddThemeObject(colorPaletteFrame, "BackgroundColor3", "ColorPickerColoro")
					corner(ud(0, 12), colorPaletteFrame)
					create("UIStroke", {Color = c3rgb(60, 60, 70), Thickness = 2, Parent = colorPaletteFrame})
					tabRef.SharedPaletteUI.Frame = colorPaletteFrame

					local titleFrame = create("Frame", {Parent = colorPaletteFrame, BackgroundTransparency = 1, Size = ud2(1, 0, 0, 40), ZIndex = 51})
					local titleLabel = create("TextLabel", {
						Parent = titleFrame, Text = "Choose a color", Font = enum.Font.GothamSemibold,
						TextSize = 16, BackgroundTransparency = 1, Size = ud2(1, 0, 1, 0), ZIndex = 52
					})
					tabRef:AddThemeObject(titleLabel, "TextColor3", "TabTextColor")

					local svGradient = create("Frame", {Parent = colorPaletteFrame, Size = ud2(0, 200, 0, 200), Position = ud2(0.435, -100, 0, 50), ZIndex = 51})
					corner(ud(0, 8), svGradient)
					tabRef.SharedPaletteUI.SVGradient = svGradient

					local whiteOverlay = create("Frame", {Parent = svGradient, Size = ud2(1, 0, 1, 0), BackgroundColor3 = c3new(1, 1, 1), ZIndex = 51})
					corner(ud(0, 8), whiteOverlay)
					create("UIGradient", {Parent = whiteOverlay, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})})

					local blackOverlay = create("Frame", {Parent = svGradient, Size = ud2(1, 0, 1, 0), BackgroundColor3 = c3new(0, 0, 0), ZIndex = 51})
					corner(ud(0, 8), blackOverlay)
					create("UIGradient", {Parent = blackOverlay, Rotation = 90, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)})})

					local svSelector = create("Frame", {Parent = svGradient, Size = ud2(0, 14, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 2, BorderColor3 = c3new(1, 1, 1), ZIndex = 52})
					corner(ud(1, 0), svSelector)
					tabRef.SharedPaletteUI.SVSelector = svSelector

					local innerCircle = create("Frame", {Parent = svSelector, Size = ud2(0, 6, 0, 6), AnchorPoint = Vector2.new(0.5, 0.5), Position = ud2(0.5, 0, 0.5, 0), ZIndex = 53})
					corner(ud(1, 0), innerCircle)
					tabRef.SharedPaletteUI.InnerCircle = innerCircle

					local hueFrame = create("Frame", {Parent = colorPaletteFrame, Size = ud2(0, 20, 0, 200), Position = ud2(0.82, 0, 0, 50), BackgroundTransparency = 1, ZIndex = 51})
					local hueGradientFrame = create("Frame", {Parent = hueFrame, Size = ud2(1, 0, 1, 0), ZIndex = 51})
					corner(ud(0, 8), hueGradientFrame)

					local hueColors = {}
					for i = 0, 6 do table.insert(hueColors, ColorSequenceKeypoint.new(i/6, Color3.fromHSV(i/6, 1, 1))) end
					create("UIGradient", {Parent = hueGradientFrame, Rotation = 90, Color = ColorSequence.new(hueColors)})

					local hueSlider = create("Frame", {Parent = hueFrame, Size = ud2(1, 0, 0, 4), BackgroundColor3 = c3new(1, 1, 1), BorderSizePixel = 0, ZIndex = 52})
					corner(ud(0, 2), hueSlider)
					tabRef.SharedPaletteUI.HueSlider = hueSlider

					local inputFrame = create("Frame", {Parent = colorPaletteFrame, BackgroundTransparency = 1, Size = ud2(1, -40, 0, 40), Position = ud2(0, 30, 0, 260), ZIndex = 51})

					local hexInput = create("TextBox", {
						Parent = inputFrame, Size = ud2(0.7, 0, 1, 0),
						BackgroundColor3 = c3rgb(40, 40, 45), BackgroundTransparency = 0.5,
						Font = enum.Font.Gotham, TextSize = 14,
						TextXAlignment = enum.TextXAlignment.Center, ZIndex = 52
					})
					tabRef:AddThemeObject(hexInput, "TextColor3", "TabTextColor")
					corner(ud(0, 6), hexInput)
					create("UIStroke", {Color = c3rgb(60, 60, 70), Thickness = 1, Parent = hexInput})
					tabRef.SharedPaletteUI.HexInput = hexInput

					local previewFrame = create("Frame", {Parent = colorPaletteFrame, Size = ud2(0, 40, 0, 40), Position = ud2(0.76, 0, 0, 260), ZIndex = 51})
					corner(ud(0, 8), previewFrame)
					create("UIStroke", {Color = c3rgb(60, 60, 70), Thickness = 2, Parent = previewFrame})
					tabRef.SharedPaletteUI.PreviewFrame = previewFrame

					local function processInput(input, frame, isHueMode)
						if not tabRef.ActiveColorPickerData then return end
						local h, s, v = tabRef.ActiveColorPickerData.GetHSV()

						local y = math.clamp((input.Position.Y - frame.AbsolutePosition.Y) / frame.AbsoluteSize.Y, 0, 1)
						if isHueMode then
							h = y
						else
							local x = math.clamp((input.Position.X - frame.AbsolutePosition.X) / frame.AbsoluteSize.X, 0, 1)
							s, v = x, 1 - y
						end

						tabRef.ActiveColorPickerData.SetColor(Color3.fromHSV(h, s, v), h, s, v)
					end

					local draggingHue, draggingSV = false, false

					hueFrame.InputBegan:Connect(function(input)
						if input.UserInputType == enum.UserInputType.MouseButton1 or input.UserInputType == enum.UserInputType.Touch then
							draggingHue = true; processInput(input, hueFrame, true)
						end
					end)

					svGradient.InputBegan:Connect(function(input)
						if input.UserInputType == enum.UserInputType.MouseButton1 or input.UserInputType == enum.UserInputType.Touch then
							draggingSV = true; processInput(input, svGradient, false)
						end
					end)

					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == enum.UserInputType.MouseButton1 or input.UserInputType == enum.UserInputType.Touch then
							draggingHue, draggingSV = false, false
						end
					end)

					UserInputService.InputChanged:Connect(function(input)
						if input.UserInputType == enum.UserInputType.MouseMovement or input.UserInputType == enum.UserInputType.Touch then
							if draggingHue then processInput(input, hueFrame, true)
							elseif draggingSV then processInput(input, svGradient, false) end
						end
					end)

					hexInput.FocusLost:Connect(function(enterPressed)
						if enterPressed and tabRef.ActiveColorPickerData then
							local hex = hexInput.Text:gsub("#", "")
							if #hex == 6 then
								local r, g, b = tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
								if r and g and b then
									local c = c3rgb(r, g, b)
									local h, s, v = c:ToHSV()
									tabRef.ActiveColorPickerData.SetColor(c, h, s, v)
								end
							else
								local d = tabRef.ActiveColorPickerData
								local h, s, v = d.GetHSV()
								tabRef.UpdateSharedPaletteVisuals(d.GetCurrentColor(), h, s, v)
							end
						end
					end)

					tabRef.TogglePaletteOff = function()
						if colorPaletteFrame.Visible then
							self:Tween(colorPaletteFrame, {
								Size = ud2(0, 0, 0, 0)
							}, 0.2).Completed:Once(function()
								colorPaletteFrame.Visible = false
								modalBackground.Visible = false
								tabRef.ActiveColorPicker = nil
								tabRef.ActiveColorPickerData = nil
							end)
						end
					end

					modalBackground.InputBegan:Connect(function(input)
						if input.UserInputType == enum.UserInputType.MouseButton1 or input.UserInputType == enum.UserInputType.Touch then
							local pos, absPos, absSize = input.Position, colorPaletteFrame.AbsolutePosition, colorPaletteFrame.AbsoluteSize
							if pos.X < absPos.X or pos.X > absPos.X + absSize.X or pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
								tabRef.TogglePaletteOff()
							end
						end
					end)

					tabRef.UpdateSharedPaletteVisuals = function(cColor, cHue, cSat, cVal)
						tabRef.SharedPaletteUI.SVGradient.BackgroundColor3 = Color3.fromHSV(cHue, 1, 1)
						tabRef.SharedPaletteUI.HueSlider.Position = ud2(0, 0, cHue, -2)
						tabRef.SharedPaletteUI.SVSelector.Position = ud2(cSat, 0, 1 - cVal, 0)
						tabRef.SharedPaletteUI.InnerCircle.BackgroundColor3 = cColor
						tabRef.SharedPaletteUI.PreviewFrame.BackgroundColor3 = cColor

						local r, g, b = math.floor(cColor.R * 255), math.floor(cColor.G * 255), math.floor(cColor.B * 255)
						tabRef.SharedPaletteUI.HexInput.Text = string.format("#%02X%02X%02X", r, g, b)
					end
				end

				if tabRef.SharedPaletteUI.Frame.Visible and tabRef.ActiveColorPicker == ColorPick then
					tabRef.TogglePaletteOff()
					return
				end

				tabRef.ActiveColorPicker = ColorPick
				tabRef.ActiveColorPickerData = {
					Controller = colorPickerObj,
					GetHSV = function() return hue, saturation, value end,
					GetCurrentColor = function() return currentColor end,
					SetColor = function(c, h, s, v) colorPickerObj:SetColor(c, h, s, v) end
				}

				tabRef.UpdateSharedPaletteVisuals(currentColor, hue, saturation, value)

