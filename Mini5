	-- ==================== AddDropdown ====================
	function tab:AddDropdown(config)
		local dropdownName = config.Name or "Dropdown"
		local desc = config.Description or ""
		local callback = config.Callback

		local dropdownObj = {
			Name = dropdownName,
			Options = config.Options or {},
			Multi = config.Multi or false,
			Selected = config.Multi and {} or nil,
			Elem = nil,
			_textLabel = nil,
			_refreshVisuals = nil,
			_closeDropdown = nil,
			_openDropdown = nil,
			_isDropdownOpen = nil
		}

		function dropdownObj:GetValue()
			return self.Selected
		end

		function dropdownObj:SetValue(value)
			if self.Multi then
				local newSelected = {}

				if type(value) == "table" then
					for option, selected in pairs(value) do
						if selected and table.find(self.Options, option) then
							newSelected[option] = true
						end
					end
				end

				self.Selected = newSelected

				local selectedText = ""
				for option in pairs(self.Selected) do
					selectedText = selectedText == "" and option or (selectedText .. ", " .. option)
				end

				if self._textLabel then
					self._textLabel.Text = selectedText ~= "" and selectedText or "Select..."
				end
			else
				if value and table.find(self.Options, value) then
					self.Selected = value
					if self._textLabel then
						self._textLabel.Text = tostring(value)
					end
				else
					self.Selected = nil
					if self._textLabel then
						self._textLabel.Text = "Select..."
					end
				end
			end

			if self._refreshVisuals then
				self._refreshVisuals()
			end

			if callback then
				task.spawn(callback, self.Selected)
			end
		end

		function dropdownObj:UpdateOptions(newOptions, newDefault)
			self.Options = newOptions

			if self._isDropdownOpen and self._isDropdownOpen() then
				self._openDropdown()
			end

			self:SetValue(newDefault or (self.Multi and {} or nil))
		end

		function dropdownObj:SetVisible(visible)
			if self.Elem then self.Elem.Visible = visible end
		end

		function dropdownObj:Destroy()
			if self._closeDropdown then self._closeDropdown() end
			if self.Elem then self.Elem:Destroy() end
		end

		if self.AllElements and self.AllElements.Dropdowns then
			self.AllElements.Dropdowns[dropdownName] = dropdownObj
		end

		if config.Default then
			dropdownObj:SetValue(config.Default)
		end

		local renderFunc = function()
			local guiRoot = self.Container.Parent.Parent

			-- Общий контейнер списка на всю библиотеку
			if not Library.SharedDropdownState then
				local SharedContainer = create("ImageLabel", {
					Name = "SharedDropdownContainer", BackgroundColor3 = c3rgb(48, 48, 48),
					BackgroundTransparency = 1, BorderColor3 = c3rgb(0, 0, 0),
					BorderSizePixel = 0, Size = ud2(0, 135, 0, 0),
					Visible = false, ZIndex = 50, Image = "ImageLabel_2",
					ImageTransparency = 0.9, ClipsDescendants = true, Parent = guiRoot
				})

				local SharedOptions = create("ScrollingFrame", {
					Active = true, BorderSizePixel = 0,
					Position = ud2(0.0277, 0, 0.035, 0), Size = ud2(0, 135, 0, 0),
					ZIndex = 50, ScrollBarThickness = 2, ClipsDescendants = true,
					CanvasSize = ud2(0, 0, 0, 0), AutomaticCanvasSize = enum.AutomaticSize.Y,
					Parent = SharedContainer
				})
				self:themeObj(SharedOptions, {BackgroundColor3 = "DropDownColor", BackgroundTransparency = "DropDownTransparency"})
				corner(ud(0, 5), SharedOptions)
				create("UIListLayout", {Parent = SharedOptions, SortOrder = enum.SortOrder.LayoutOrder})

				Library.SharedDropdownState = {
					Container = SharedContainer,
					OptionsFrame = SharedOptions,
					ActiveCloseFunc = nil,
					ClickConnection = nil
				}
			end

			local SharedContainer = Library.SharedDropdownState.Container
			local SharedOptions = Library.SharedDropdownState.OptionsFrame

			local Dropdown = self:CreateRow("Frame", dropdownName, desc)

			local Select = create("TextButton", {
				Position = ud2(0.576, 0, 0.155, 0), Size = ud2(0, 135, 0, 30),
				Text = "", Parent = Dropdown
			})
			self:themeObj(Select, {BackgroundColor3 = "BackGroundElemCol", BackgroundTransparency = "BackGroundButtonTran"})
			corner(ud(0, 5), Select)

			local TextLabel = create("TextLabel", {
				BackgroundTransparency = 1, Position = ud2(0.038, 0, -0.02, 0),
				Size = ud2(0, 88, 0, 30), Font = FONT, TextSize = 14,
				TextXAlignment = LEFT, TextWrapped = true,
				TextTruncate = enum.TextTruncate.AtEnd, Parent = Select
			})
			self:AddThemeObject(TextLabel, "TextColor3", "TabTextColor")

			local ImageLabel = create("ImageLabel", {
				BackgroundTransparency = 1, Position = ud2(0.816, 0, 0.166, 0),
				Size = ud2(0, 20, 0, 20), Image = "rbxassetid://126982255108418",
				Parent = Select
			})
			self:AddThemeObject(ImageLabel, "ImageColor3", "DropDownArrowImg")

			dropdownObj.Elem = Dropdown
			dropdownObj._textLabel = TextLabel

			local selectedText = ""
			if dropdownObj.Multi then
				for opt, sel in pairs(dropdownObj.Selected) do
					if sel then selectedText = selectedText .. (selectedText == "" and opt or ", " .. opt) end
				end
				TextLabel.Text = selectedText == "" and "Select..." or selectedText
			else
				TextLabel.Text = dropdownObj.Selected and tostring(dropdownObj.Selected) or "Select..."
			end

			local optionElements = {}

			local function refreshVisuals()
				for optText, frameInd in pairs(optionElements) do
					local isSelected = dropdownObj.Multi and dropdownObj.Selected[optText] or (dropdownObj.Selected == optText)
					if isSelected then
						Library:Tween(frameInd, {Size = ud2(0, 2, 0, 22), BackgroundTransparency = 0}, 0.2)
					else
						Library:Tween(frameInd, {Size = ud2(0, 2, 0, 0), BackgroundTransparency = 1}, 0.2)
					end
				end
			end

			local function closeDropdown()
				if not SharedContainer.Visible then return end
				Library:Tween(SharedContainer, {Size = ud2(0, 140, 0, 0)}, 0.2)
				Library:Tween(SharedOptions, {Size = ud2(0, 135, 0, 0)}, 0.2)

				if Library.SharedDropdownState.ClickConnection then
					Library.SharedDropdownState.ClickConnection:Disconnect()
					Library.SharedDropdownState.ClickConnection = nil
				end

				task.delay(0.2, function()
					if Library.SharedDropdownState.ActiveCloseFunc == closeDropdown then
						SharedContainer.Visible = false
						table.clear(optionElements)
					end
				end)
			end

			local function handleOptionClick(option)
				if dropdownObj.Multi then
					local current = table.clone(dropdownObj.Selected)
					current[option] = not current[option]
					dropdownObj:SetValue(current)
				else
					dropdownObj:SetValue(option)
					closeDropdown()
				end
			end

			local function createOption(optionText)
				local Option = create("TextButton", {
					BackgroundTransparency = 1, Size = ud2(0, 135, 0, 30),
					Text = "", Parent = SharedOptions
				})

				local Frame = create("Frame", {
					BorderSizePixel = 0, Position = ud2(0.01, 0, 0, 4),
					Size = ud2(0, 2, 0, 0), Transparency = 1, Parent = Option
				})
				self:AddThemeObject(Frame, "BackgroundColor3", "DropDownFrameColor")

				optionElements[optionText] = Frame

				Option.MouseEnter:Connect(function()
					Library:Tween(Option, {BackgroundTransparency = 0.95}, 0.3)
					local isSelected = dropdownObj.Multi and dropdownObj.Selected[optionText] or (dropdownObj.Selected == optionText)
					if not isSelected then
						Library:Tween(Frame, {Size = ud2(0, 2, 0, 22), BackgroundTransparency = 0.5}, 0.3)
					end
				end)

				Option.MouseLeave:Connect(function()
					Library:Tween(Option, {BackgroundTransparency = 1}, 0.3)
					local isSelected = dropdownObj.Multi and dropdownObj.Selected[optionText] or (dropdownObj.Selected == optionText)
					if not isSelected then
						Library:Tween(Frame, {BackgroundTransparency = 1, Size = ud2(0, 2, 0, 0)}, 0.3)
					end
				end)

				local OptionTextLabel = create("TextLabel", {
					BackgroundTransparency = 1, Position = ud2(0.047, 0, 0, 0),
					Size = ud2(0, 124, 0, 30), Font = FONT, Text = optionText,
					TextSize = 14, TextXAlignment = LEFT, TextWrapped = true,
					TextTruncate = enum.TextTruncate.AtEnd, Parent = Option
				})
				self:AddThemeObject(OptionTextLabel, "TextColor3", "TabTextColor")

				Option.MouseButton1Click:Connect(function() handleOptionClick(optionText) end)
			end

			local function updateDropdownPosition()
				if not SharedContainer.Visible then return end
				local absolutePos = Select.AbsolutePosition
				local containerPos = guiRoot.AbsolutePosition

				local currentScale = 1
				local ancestor = guiRoot
				while ancestor and not ancestor:IsA("ScreenGui") do
					local uiScale = ancestor:FindFirstChildWhichIsA("UIScale")
					if uiScale then currentScale *= uiScale.Scale end
					ancestor = ancestor.Parent
				end

				local x = (absolutePos.X - containerPos.X) / currentScale - 4
				local y = (absolutePos.Y - containerPos.Y + Select.AbsoluteSize.Y) / currentScale
				SharedContainer.Position = ud2(0, x, 0, y)
			end

			local function openDropdown()
				if Library.SharedDropdownState.ActiveCloseFunc and Library.SharedDropdownState.ActiveCloseFunc ~= closeDropdown then
					Library.SharedDropdownState.ActiveCloseFunc()
				end

				Library.SharedDropdownState.ActiveCloseFunc = closeDropdown

				for _, child in pairs(SharedOptions:GetChildren()) do
					if child:IsA("TextButton") then child:Destroy() end
				end
				table.clear(optionElements)

				for _, option in ipairs(dropdownObj.Options) do createOption(option) end

				updateDropdownPosition()
				SharedContainer.Visible = true

				local height = math.min(150, #dropdownObj.Options * 30)
				Library:Tween(SharedContainer, {Size = ud2(0, 140, 0, height + 10)}, 0.2)
				Library:Tween(SharedOptions, {Size = ud2(0, 135, 0, height)}, 0.2)
				refreshVisuals()

				task.spawn(function()
					while SharedContainer.Visible and Library.SharedDropdownState.ActiveCloseFunc == closeDropdown do
						updateDropdownPosition()
						task.wait()
					end
				end)

				if Library.SharedDropdownState.ClickConnection then Library.SharedDropdownState.ClickConnection:Disconnect() end
				Library.SharedDropdownState.ClickConnection = UserInputService.InputBegan:Connect(function(input)
					if input.UserInputType == enum.UserInputType.MouseButton1 or input.UserInputType == enum.UserInputType.Touch then
						local pos = input.Position
						local inSelect = pos.X >= Select.AbsolutePosition.X and pos.X <= Select.AbsolutePosition.X + Select.AbsoluteSize.X and pos.Y >= Select.AbsolutePosition.Y and pos.Y <= Select.AbsolutePosition.Y + Select.AbsoluteSize.Y
						local inOptions = pos.X >= SharedContainer.AbsolutePosition.X and pos.X <= SharedContainer.AbsolutePosition.X + SharedContainer.AbsoluteSize.X and pos.Y >= SharedContainer.AbsolutePosition.Y and pos.Y <= SharedContainer.AbsolutePosition.Y + SharedContainer.AbsoluteSize.Y

						if not inSelect and not inOptions then closeDropdown() end
					end
				end)
			end

			Select.MouseButton1Click:Connect(function()
				if SharedContainer.Visible and Library.SharedDropdownState.ActiveCloseFunc == closeDropdown then
					closeDropdown()
				else
					openDropdown()
				end
			end)

			dropdownObj._refreshVisuals = function()
				if Library.SharedDropdownState.ActiveCloseFunc == closeDropdown then refreshVisuals() end
			end
			dropdownObj._closeDropdown = function()
				if Library.SharedDropdownState.ActiveCloseFunc == closeDropdown then closeDropdown() end
			end
			dropdownObj._openDropdown = openDropdown
			dropdownObj._isDropdownOpen = function()
				return SharedContainer.Visible and Library.SharedDropdownState.ActiveCloseFunc == closeDropdown
			end
		end

		return register(tab, dropdownObj, renderFunc)
	end

