					local data = HttpService:JSONDecode(res.Body)
					Name.Text = data.guild.name
					Status.Text = ("<font color='#23a559'>●</font> %s Online  <font color='#80848e'>●</font> %s Members"):format(data.approximate_presence_count or 0, data.approximate_member_count or 0)
				else
					Name.Text = "Invalid Invite"
					Status.Text = "Could not fetch server data"
				end
			end)

			discordController.Elem = Widget
		end

		return register(tab, discordController, renderFunc)
	end

	-- ==================== AddParagraph ====================
	function tab:AddParagraph(title, subtitle, backColor, color)
		local paragraphController = {
			Element = nil, Elem = nil,
			Title = title or "", Subtitle = subtitle or "",
			IsDestroyed = false
		}

		local renderFunc = function()
			if paragraphController.IsDestroyed then return end

			local Paragraph = create("Frame", {BorderSizePixel = 0, Parent = self.Container})
			if typeof(backColor) == "Color3" then
				Paragraph.BackgroundColor3 = backColor
			else
				self:themeObj(Paragraph, {BackgroundColor3 = "BackGroundElemCol", BackgroundTransparency = "BackGroundElemTran"})
			end
			corner(ud(0, 12), Paragraph)

			local TitleLabel = create("TextLabel", {
				BackgroundTransparency = 1, Size = ud2(0, 328, 0, 20),
				Font = FONT, Text = paragraphController.Title,
				TextSize = 16, TextXAlignment = LEFT, Parent = Paragraph
			})

			local ContentLabel = create("TextLabel", {
				BackgroundTransparency = 1, Font = FONT,
				Text = paragraphController.Subtitle, TextSize = 14,
				TextWrapped = true, TextXAlignment = LEFT,
				TextYAlignment = enum.TextYAlignment.Top, Parent = Paragraph
			})

			if typeof(color) == "Color3" then
				TitleLabel.TextColor3 = color
				ContentLabel.TextColor3 = color
			else
				self:AddThemeObject(TitleLabel, "TextColor3", "TabTextColor")
				self:AddThemeObject(ContentLabel, "TextColor3", "TabSubTtitleTextColor")
			end

			paragraphController.Element = Paragraph
			paragraphController.Elem = Paragraph
			paragraphController._TitleLabel = TitleLabel
			paragraphController._ContentLabel = ContentLabel

			paragraphController.RecalcSizes = function()
				local contentText = paragraphController._ContentLabel.Text
				local hasSubtitle = contentText ~= ""

				if hasSubtitle then
					local textSizeVec = TextService:GetTextSize(contentText, paragraphController._ContentLabel.TextSize, paragraphController._ContentLabel.Font, Vector2.new(328, 10000))
					local contentHeight = math.max(16, math.ceil(textSizeVec.Y))

					paragraphController._ContentLabel.Visible = true
					paragraphController._ContentLabel.Position = ud2(0.027, 0, 0, 28)
					paragraphController._ContentLabel.Size = ud2(0, 328, 0, contentHeight + 4)

					paragraphController._TitleLabel.Position = ud2(0.027, 0, 0, 5)
					paragraphController.Elem.Size = ud2(0, 360, 0, 33 + contentHeight)
				else
					paragraphController._ContentLabel.Visible = false
					paragraphController.Elem.Size = ud2(0, 360, 0, 40)
					paragraphController._TitleLabel.Position = ud2(0.027, 0, 0, 10)
				end
			end

			paragraphController.RecalcSizes()
		end

		paragraphController.Update = function(objSelf, newTitle, newSubtitle)
			if newTitle then objSelf.Title = newTitle end
			if newSubtitle ~= nil then objSelf.Subtitle = newSubtitle end

			if objSelf.Elem then
				objSelf._TitleLabel.Text = objSelf.Title
				objSelf._ContentLabel.Text = objSelf.Subtitle
				objSelf.RecalcSizes()
			end
		end

		paragraphController.Destroy = function(objSelf)
			objSelf.IsDestroyed = true
			if objSelf.Element then
				objSelf.Element:Destroy()
				objSelf.Element = nil
				objSelf.Elem = nil
			end
		end

		return register(tab, paragraphController, renderFunc)
	end

