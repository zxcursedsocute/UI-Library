	-- ==================== AddList ====================
	function tab:AddList(config)
		local Config = {
			Name = config.Name,
			Elems = config.Elems or {}
		}

		local listController = {
			Elem = nil, IsOpen = false, IsLoaded = false, RenderQueue = {}
		}

		for _, v in pairs(Config.Elems) do
			if v and v._renderFunc then
				local idx = table.find(tab.RenderQueue, v._renderFunc)
				if idx then
					table.remove(tab.RenderQueue, idx)
					table.insert(listController.RenderQueue, v._renderFunc)
				end
			end
		end

		local renderFunc = function()
			local ListWrapper = create("Frame", {
				BackgroundTransparency = 0.95, Size = ud2(0, 360, 0, 0),
				AutomaticSize = enum.AutomaticSize.Y, Parent = self.Container
			})
			self:AddThemeObject(ListWrapper, "BackgroundColor3", "ListFrameColor")
			corner(ud(0, 10), ListWrapper)
			create("UIListLayout", {Parent = ListWrapper, SortOrder = enum.SortOrder.LayoutOrder})

			local List = create("TextButton", {
				Size = ud2(0, 360, 0, 35), Text = "", LayoutOrder = 1,
				Parent = ListWrapper
			})
			self:themeObj(List, {BackgroundColor3 = "BackGroundElemCol", BackgroundTransparency = "BackGroundElemTran"})
			corner(ud(0, 10), List)

			local listName = create("TextLabel", {
				BackgroundTransparency = 1, Position = ud2(0.03, 0, 0, 0),
				Size = ud2(0.7, 0, 1, 0), Font = FONT, Text = Config.Name,
				TextSize = 16, TextXAlignment = LEFT, Parent = List
			})
			self:AddThemeObject(listName, "TextColor3", "TabTextColor")

			local ImageLabel = create("ImageLabel", {
				BackgroundTransparency = 1, Position = ud2(0.9, 0, 0.2, 0),
				Rotation = -180, Size = ud2(0, 20, 0, 20),
				Image = "rbxassetid://126982255108418", Parent = List
			})
			self:AddThemeObject(ImageLabel, "ImageColor3", "DropDownArrowImg")

			local BackFrame = create("Frame", {
				BackgroundTransparency = 1, ClipsDescendants = true,
				Size = ud2(0, 360, 0, 0), Visible = false,
				LayoutOrder = 2, Parent = ListWrapper
			})
			local ItemsLayout = create("UIListLayout", {Parent = BackFrame, Padding = ud(0, 5), SortOrder = enum.SortOrder.LayoutOrder})
			local Padding = create("UIPadding", {Parent = BackFrame, PaddingTop = ud(0, 5)})

			for _, v in pairs(Config.Elems) do
				if v and v.Elem then
					v.Elem.Parent = BackFrame
					v.Elem.Visible = true
				end
			end

			listController.Elem = ListWrapper

			List.MouseButton1Click:Connect(function()
				local justLoaded = false

				if not listController.IsLoaded then
					listController.IsLoaded = true
					justLoaded = true

					for _, rFunc in ipairs(listController.RenderQueue) do
						rFunc()
					end

					for _, v in pairs(Config.Elems) do
						if v and v.Elem then
							v.Elem.Parent = BackFrame
							v.Elem.Visible = true
						end
					end
				end

				listController.IsOpen = not listController.IsOpen
				self:Tween(ImageLabel, {Rotation = listController.IsOpen and 0 or -180}, 0.3)

				if listController.IsOpen then
					BackFrame.Visible = true
					if justLoaded then task.wait() end

					local correctContentHeight = ItemsLayout.AbsoluteContentSize.Y / (self.ScaleFactor or 1)
					local targetHeight = correctContentHeight + Padding.PaddingTop.Offset + Padding.PaddingBottom.Offset
					self:Tween(BackFrame, {Size = ud2(0, 360, 0, targetHeight)}, 0.4)
				else
					self:Tween(BackFrame, {Size = ud2(0, 360, 0, 0)}, 0.3)
					task.delay(0.3, function()
						if not listController.IsOpen then
							BackFrame.Visible = false
						end
					end)
				end
			end)
		end

		return register(tab, listController, renderFunc)
	end

