	-- ==================== AddSlider ====================
	function tab:AddSlider(config)
		local minVal = config.Min or 0
		local maxVal = config.Max or 100
		local sliderName = config.Name or "Slider"
		local desc = config.Description or ""

		local defaultValue = config.Default
		if defaultValue == nil then
			defaultValue = minVal
		end

		-- Общее состояние слайдеров (один обработчик на всю библиотеку)
		if not Library.SharedSliderState then
			Library.SharedSliderState = {
				ActiveMoveFunc = nil,
				ActiveReleaseFunc = nil
			}

			UserInputService.InputChanged:Connect(function(input)
				local state = Library.SharedSliderState
				local moveFunc = state and state.ActiveMoveFunc

				if moveFunc and (input.UserInputType == enum.UserInputType.MouseMovement or input.UserInputType == enum.UserInputType.Touch) then
					moveFunc(input)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType ~= enum.UserInputType.MouseButton1 and input.UserInputType ~= enum.UserInputType.Touch then
					return
				end

				local state = Library.SharedSliderState
				if state.ActiveReleaseFunc then
					state.ActiveReleaseFunc()
				end
				state.ActiveMoveFunc = nil
				state.ActiveReleaseFunc = nil

				if Library then
					Library.IsInteractingWithUI = false
				end
			end)
		end

		local sliderObj = {
			Elem = nil,
			Name = sliderName,
			Value = math.clamp(defaultValue, minVal, maxVal)
		}

		-- Как в оригинале: целые числа при большом диапазоне
		local useIntegerDisplay = maxVal > 10

		local function getDisplayValue(rawValue)
			if useIntegerDisplay then
				return math.floor(rawValue + 0.5)
			end
			return math.floor(rawValue * 10 + 0.5) / 10
		end

		local function getPercent(rawValue)
			local range = maxVal - minVal
			if range <= 0 then return 0 end
			return math.clamp((rawValue - minVal) / range, 0, 1)
		end

		function sliderObj:GetValue()
			return self.Value
		end

		-- silent = true: значение/обновляются, но Callback не вызывается
		function sliderObj:SetValue(newValue, silent)
			newValue = tonumber(newValue) or minVal
			newValue = math.clamp(newValue, minVal, maxVal)

			self.Value = newValue

			local displayValue = getDisplayValue(newValue)
			local percent = getPercent(newValue)

			if self._sliderbutton then
				self._underline.Size = ud2(percent, 0, 0, 2)
				self._sliderball.Position = ud2(percent, 0, 0.5, 0)

				if useIntegerDisplay then
					self._slideramount.Text = tostring(displayValue)
				else
					self._slideramount.Text = string.format("%.1f", displayValue)
				end
			end

			if not silent and config.Callback then
				task.spawn(config.Callback, displayValue)
			end
		end

		if self.AllElements and self.AllElements.Sliders then
			self.AllElements.Sliders[sliderName] = sliderObj
		end

		-- Callback на стартовом значении — как в оригинале
		sliderObj:SetValue(sliderObj.Value)

		local renderFunc = function()
			local slider = self:CreateRow("Frame", sliderName, desc)
			slider.Active = true

			local sliderbutton = create("Frame", {
				BackgroundTransparency = 1, Position = ud2(0.671, 0, 0.244, 0),
				Size = ud2(0, 100, 0, 22), Active = true, Parent = slider
			})

			create("Frame", {
				BackgroundColor3 = c3rgb(255, 255, 255), BorderSizePixel = 0,
				Position = ud2(0, 0, 0.455, 0), Size = ud2(1, 0, 0, 2),
				Parent = sliderbutton
			})

			local sliderball = create("Frame", {
				BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
				Position = ud2(0, 0, 0.5, 0), Size = ud2(0, 15, 0, 15),
				ZIndex = 2, Parent = sliderbutton
			})
			corner(ud(1, 0), sliderball)
			self:AddThemeObject(sliderball, "BackgroundColor3", "Sliderball")

			local slideramount = create("TextLabel", {
				BackgroundTransparency = 1, Position = ud2(0, -35, 0.075, 0),
				Size = ud2(0, 21, 0, 18), Font = FONT, TextSize = 14,
				Parent = sliderbutton
			})
			self:AddThemeObject(slideramount, "TextColor3", "TabTextColor")

			local underline = create("Frame", {
				BorderSizePixel = 0, Position = ud2(0, 0, 0.455, 0),
				Size = ud2(0, 0, 0, 2), Parent = sliderbutton
			})
			self:AddThemeObject(underline, "BackgroundColor3", "SliderUnderLineColor")

			sliderObj.Elem = slider
			sliderObj._sliderbutton = sliderbutton
			sliderObj._underline = underline
			sliderObj._sliderball = sliderball
			sliderObj._slideramount = slideramount

			-- Стартовое состояние
			local currentPercent = getPercent(sliderObj.Value)
			local currentDisplayValue = getDisplayValue(sliderObj.Value)

			underline.Size = ud2(currentPercent, 0, 0, 2)
			sliderball.Position = ud2(currentPercent, 0, 0.5, 0)

			if useIntegerDisplay then
				slideramount.Text = tostring(currentDisplayValue)
			else
				slideramount.Text = string.format("%.1f", currentDisplayValue)
			end

			local function moveSlider(input)
				local width = sliderbutton.AbsoluteSize.X
				if width <= 0 then return end

				local percent = math.clamp((input.Position.X - sliderbutton.AbsolutePosition.X) / width, 0, 1)
				-- silent = true: без Callback во время перетаскивания
				sliderObj:SetValue(minVal + percent * (maxVal - minVal), true)
			end

			sliderbutton.InputBegan:Connect(function(input)
				if input.UserInputType ~= enum.UserInputType.MouseButton1 and input.UserInputType ~= enum.UserInputType.Touch then
					return
				end

				if Library then
					Library.IsInteractingWithUI = true
				end

				local state = Library.SharedSliderState
				state.ActiveMoveFunc = moveSlider

				-- Callback только при отпускании
				state.ActiveReleaseFunc = function()
					local finalValue = sliderObj:GetValue()
					local displayValue = getDisplayValue(finalValue)
					if config.Callback then
						task.spawn(config.Callback, displayValue)
					end
				end

				moveSlider(input)
			end)
		end

		return register(tab, sliderObj, renderFunc)
	end

	-- ==================== AddColorPicker ====================
	function tab:AddColorPicker(config)
		local tabRef = self
		local colorName = config.Name or "ColorPicker"
		local desc = config.Description or ""
		local defaultColor = config.Default or c3new(1, 1, 1)
		local callback = config.Callback

		local currentColor = defaultColor
		local hue, saturation, value = currentColor:ToHSV()

		local colorPickerObj = {
			Elem = nil,
			Name = colorName,
			Description = desc,
			GetColor = function() return currentColor end
		}

		function colorPickerObj:SetColor(color, newH, newS, newV)
			if not color then return end
			currentColor = color

			if newH and newS and newV then
				hue, saturation, value = newH, newS, newV
			else
				local extH, extS, extV = color:ToHSV()
				hue = (extS == 0 or extV == 0) and hue or extH
				saturation = extS
				value = extV
			end

			if self._colorButton then
				self._colorButton.BackgroundColor3 = color
			end

			if tabRef.ActiveColorPickerData and tabRef.ActiveColorPickerData.Controller == self and tabRef.UpdateSharedPaletteVisuals then
				tabRef.UpdateSharedPaletteVisuals(currentColor, hue, saturation, value)
			end

			if callback then
				task.spawn(callback, color)
			end
		end

		if tabRef.AllElements and tabRef.AllElements.ColorPickers then
			tabRef.AllElements.ColorPickers[colorName] = colorPickerObj
		end

		colorPickerObj:SetColor(defaultColor)

		local renderFunc = function()
			local ColorPick = tabRef:CreateRow("Frame", colorName, desc)

			local colorButton = create("TextButton", {
				BackgroundColor3 = currentColor, BorderSizePixel = 0,
