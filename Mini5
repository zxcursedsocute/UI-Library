				BackgroundColor3 = c3rgb(36, 128, 70), Font = FONT,
				Text = "Copy Invite Link", TextColor3 = c3rgb(255, 255, 255),
				TextSize = 14, Parent = Widget
			})
			corner(ud(0, 8), Btn)

			Btn.MouseButton1Click:Connect(function()
				if setclipboard then
					setclipboard("https://discord.gg/" .. code)
					Btn.Text = "Copied to Clipboard!"
					task.wait(2)
					Btn.Text = "Copy Invite Link"
				end
			end)

			task.spawn(function()
				local req = (syn and syn.request) or (http and http.request) or http_request or request
				if not req then return end
				local res = req({Url = "https://discord.com/api/v9/invites/" .. code .. "?with_counts=true", Method = "GET"})
