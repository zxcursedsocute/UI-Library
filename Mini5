				v.Tab[1].Parent = self.ScrollingFrame
				v.Tab[1].Size = ud2(0, 130, 0, 35)
				v.Tab[1].LayoutOrder = i

				if v.Tab[4].Image ~= "" then
					v.Tab[2].Position = ud2(0.28, 0, 0, -1)
				end
			else
				if not v.Button or v.Tab[1].Parent == self.ScrollingFrame then
					v.Tab[1].Size = ud2(0, 180, 0, 35)
				end

				if v.Tab[4].Image ~= "" then
					v.Tab[2].Position = ud2(0.21, 0, 0, -1)
				end
			end
		end

		task.wait(1)
		self.Tabs.Visible = true
		self.Sections.Visible = true

		if not isCompact and self.version then
			self.version.Visible = true
		end

		if not isCompact and self.userinfo then
			self.WindowUser.Visible = true
			self.Tabs.Size = ud2(0, 185, 0, 372)
			self.ScrollingFrame.Size = ud2(0, 185, 0, 358)
		end
		self.Windowscd = false
	end
end

