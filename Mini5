-- Инстанс + свойства одной таблицей. Parent всегда ставится последним.
local function create(class, props)
	local obj = inst(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do obj[k] = v end
	if parent then obj.Parent = parent end
	return obj
end

local function corner(radius, parent)
	return create("UICorner", {CornerRadius = radius, Parent = parent})
end

-- Общий шаблон строки элемента 360x45 (Button/Toggle/Keybind/Input/Slider/Dropdown/ColorPicker).
-- Возвращает строку, лейбл имени и лейбл описания.
function Library:CreateRow(class, title, desc, nameTextSize)
	local hasDesc = desc ~= ""

	local row = create(class, {
		BorderSizePixel = 0,
		Size = ud2(0, 360, 0, 45),
		Text = (class == "TextButton") and "" or nil,
		Parent = self.Container
	})
	self:themeObj(row, {BackgroundColor3 = "BackGroundElemCol", BackgroundTransparency = "BackGroundElemTran"})
	corner(ud(0, 12), row)

	local nameLabel = create("TextLabel", {
		Parent = row, BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = ud2(0.029, 0, 0, hasDesc and 4 or 12.5),
		Size = ud2(0, 77, 0, 20), Font = FONT, Text = title,
		TextSize = nameTextSize or 16, TextXAlignment = LEFT
	})
	self:AddThemeObject(nameLabel, "TextColor3", "TabTextColor")

	local subLabel = create("TextLabel", {
		Parent = row, BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = ud2(0.029, 0, 0, 25), Size = ud2(0, 193, 0, 14),
		Font = FONT, Text = desc, TextSize = 14,
		TextXAlignment = LEFT, Visible = hasDesc
	})
	self:AddThemeObject(subLabel, "TextColor3", "TabSubTtitleTextColor")

	return row, nameLabel, subLabel
end

-- Регистрация отложенного рендера элемента
local function register(tab, controller, renderFunc)
	controller._renderFunc = renderFunc
	table.insert(tab.RenderQueue, renderFunc)
	if tab.IsLoaded then renderFunc() end
	return controller
end

