function Library:Destroy()
	if self.AllElements and self.AllElements.GlobalKeybindConnection then
		self.AllElements.GlobalKeybindConnection:Disconnect()
		self.AllElements.GlobalKeybindConnection = nil
	end
	for _, tab in ipairs(self.mainTabs) do
		for _, connection in ipairs(tab.Connections) do
			connection:Disconnect()
		end
		for _, connection in ipairs(tab.KeybindConnections) do
			connection:Disconnect()
		end
	end
	for name, controller in pairs(self.AllElements.Toggles) do
		if controller.Value == true then
			controller:SetState(false)
		end
	end
	if self.Destroy_gui then
		self.Destroy_gui.Visible = false
	end
	self.AllElements.Toggles = {}
	self.ThemeObjects = {}

	self:Tween(self.ImageLabel, {ImageTransparency = 1}, 0.8)
	self.Tabs.Visible = false
	self.Sections.Visible = false
	self.Header.Visible = false
	task.wait(0.5)
	self.UI:Destroy()
	setmetatable(self, nil)
	table.clear(self)
end

function Library:ShowDestroyQ()
	if not self.Destroy_gui then
		self:CreateDestroyGui()
	end

	if self.Destroy_gui.Visible then
		self.dTextLabel.Visible = false
		self.dTextButton.Visible = false
		self.dTextLabel_2.Visible = false
		self.dTextButton_2.Visible = false
		self:Tween(self.dFrame_2,{Transparency = 1},0.15)
		task.wait(0.15)
		self.Destroy_gui.Visible = false
	else
		local newX
		local newY = ud(0, self.ImageLabel.Size.Y.Offset - 18)

		if self.ImageLabel.Size ~= ud2(0, 620, 0, 40) and self.ImageLabel.Size ~= ud2(0, 620, 0, 480) then
			newX = ud(0, self.ImageLabel.Size.X.Offset - 14)
			self.dFrame_2.Position = ud2(0.18, 0,0.329, 0)
		else
			newX = ud(0, self.ImageLabel.Size.X.Offset - 20)
			self.dFrame_2.Position = ud2(0.307, 0,0.329, 0)
		end
		self.Destroy_gui.Size = ud2(newX, newY)
		self.Destroy_gui.Visible = true
		self:Tween(self.ImageLabel,{Position = ud2(0.5, 0, 0.5, 0)},0.25)
		self:Tween(self.dFrame_2,{Transparency = self.Theme.DestroyGFrameTransparency},0.15)
		task.wait(0.15)
		self.dTextLabel.Visible = true
		self.dTextButton.Visible = true
		self.dTextLabel_2.Visible = true
		self.dTextButton_2.Visible = true
	end
end

function Library:UserInfo()
	if self.WindowUser.Visible then
		self.userinfo = false
		self.WindowUser.Visible = false
		self.Tabs.Size = ud2(0, 185,0, 405)
		self.ScrollingFrame.Size = ud2(0, 185,0, 405)
	else
		self.WindowUser.Visible = true
		self.Tabs.Size = ud2(0, 185,0, 372)
		self.ScrollingFrame.Size = ud2(0, 185,0, 354)
		self.userinfo = true
	end
end

function Library:Close()
	if self.ImageLabel.Visible then
		self:Tween(self.ImageLabel,{Size = ud2(0, 40, 0, 0)},0)
		self.ImageLabel.Visible = false
	else
		if self.Sections.Visible == false then
			self:Tween(self.ImageLabel,{Size = ud2(0, 620, 0, 40)},0)
		elseif self.Sections.Size == ud2(0, 375,0, 370) then
			self:Tween(self.ImageLabel,{Size = ud2(0, 395,0, 480)},0)
		else
			self:Tween(self.ImageLabel,{Size = ud2(0, 620, 0, 480)},0)
		end
		self.ImageLabel.Visible = true
	end
end

